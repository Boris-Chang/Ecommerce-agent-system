# Copy this file to .env for local-only secrets.
# Never commit real credentials.

# LLM provider for the business inspection Agent: deepseek or openai.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# Required for DeepSeek.
DEEPSEEK_API_KEY=your-deepseek-api-key

# Required only when AGENT_PROVIDER=openai.
# OPENAI_API_KEY=your-openai-api-key

# Optional LangSmith tracing.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key

# Shopify Admin API credentials.
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-shopify-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret
SHOPIFY_API_VERSION=2026-04

# PostgreSQL application connection. The application connection is forced
# to default_transaction_read_only=on by the engine configuration.
DATABASE_URL=postgresql+psycopg://coolcool_app:your-password@localhost:5432/coolcool_erp
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_STATEMENT_TIMEOUT_MS=15000
DB_ECHO=false
DB_APPLICATION_NAME=python_langchain_agent

# Web dashboard defaults and allowed sales channels.
WEB_TITLE=Ecommerce BI
WEB_DEFAULT_CHANNEL_ACCOUNT_ID=CA_SHOPIFY_US
WEB_CHANNEL_ACCOUNT_IDS=CA_SHOPIFY_US,CA_AMAZON_US
WEB_SALES_LOOKBACK_DAYS=90
WEB_QUERY_LIMIT=500

# Integration tests must use an isolated database whose name ends in `_test`.
# DATABASE_TEST_URL=postgresql+psycopg://coolcool_app_test:your-password@localhost:5432/coolcool_erp_test
# Reserved for provisioning/migration tests only; never use the application account.
# DATABASE_TEST_ADMIN_URL=postgresql+psycopg://coolcool_test_admin:your-password@localhost:5432/coolcool_erp_test

# Reserved for Alembic only. Never use this account in application runtime.
# DATABASE_MIGRATION_URL=postgresql+psycopg://coolcool_migration:your-password@localhost:5432/coolcool_erp

# Required only for the exact pre-stamp schema comparison. The reference
# database must be a disposable database built from the approved baseline.
# DATABASE_REFERENCE_URL=postgresql+psycopg://readonly:your-password@localhost:5432/coolcool_erp_reference
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
